# Supabase (browser client — use the anon/public key from Dashboard → Settings → API).
# Project URL is https://<project-ref>.supabase.co; ref matches backend DATABASE_USERNAME after "postgres." (e.g. postgres.abcxyz → https://abcxyz.supabase.co).
VITE_API_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=<your-google-web-client-id>
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
# Optional; dashboard “publishable” key if you need it later
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_REST_URL=https://<your-project-ref>.supabase.co/rest/v1/
