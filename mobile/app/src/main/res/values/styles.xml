<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base style required for Widget.LaundryLink.* dotted names -->
    <style name="Widget.LaundryLink" parent="android:Widget" />

    <style name="Widget.LaundryLink.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ll_card</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/ll_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LaundryLink.Card.Hero" parent="Widget.LaundryLink.Card">
        <item name="cardBackgroundColor">@color/ll_primary</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.LaundryLink.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ll_primary</item>
        <item name="android:textColor">@color/ll_primary_foreground</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LaundryLink.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/ll_secondary</item>
        <item name="android:textColor">@color/ll_secondary_foreground</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LaundryLink.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ll_border</item>
        <item name="android:textColor">@color/ll_foreground</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Widget.LaundryLink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ll_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LaundryLink.InputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ll_border</item>
        <item name="boxBackgroundColor">@color/ll_card</item>
        <item name="hintTextColor">@color/ll_muted_foreground</item>
    </style>

    <style name="Widget.LaundryLink.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/ll_card</item>
        <item name="titleTextColor">@color/ll_foreground</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.LaundryLink.Toolbar.Detail" parent="Widget.LaundryLink.Toolbar">
        <item name="android:background">@color/ll_card</item>
        <item name="navigationIconTint">@color/ll_foreground</item>
    </style>

    <style name="Widget.LaundryLink.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.LaundryLink.ErrorBanner" parent="android:Widget.TextView">
        <item name="android:background">@color/ll_destructive_muted</item>
        <item name="android:textColor">@color/ll_destructive</item>
        <item name="android:textSize">13sp</item>
        <item name="android:padding">@dimen/spacing_3</item>
    </style>

    <style name="Widget.LaundryLink.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ll_primary_muted</item>
    </style>

</resources>
