<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ll_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_5">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LaundryLink.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back!"
                    android:textAppearance="@style/TextAppearance.LaundryLink.OnPrimaryMuted" />

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_1"
                    android:text="Ready to do laundry?"
                    android:textAppearance="@style/TextAppearance.LaundryLink.Title"
                    android:textColor="@color/ll_primary_foreground" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_5"
            android:layout_marginBottom="@dimen/spacing_3"
            android:text="Quick Actions"
            android:textAppearance="@style/TextAppearance.LaundryLink.Subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookNow"
                style="@style/Widget.LaundryLink.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Book Now" />

            <Space
                android:layout_width="@dimen/spacing_3"
                android:layout_height="match_parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyBookings"
                style="@style/Widget.LaundryLink.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="My Bookings" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_5"
            android:layout_marginBottom="@dimen/spacing_3"
            android:text="Nearby Shops"
            android:textAppearance="@style/TextAppearance.LaundryLink.Subtitle" />

        <ProgressBar
            android:id="@+id/nearbyShopsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/ll_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nearbyShopsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_banner"
            android:fontFamily="@font/plus_jakarta_sans"
            android:padding="@dimen/spacing_3"
            android:textColor="@color/ll_destructive"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyShops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
