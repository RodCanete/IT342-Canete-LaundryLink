<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ll_card" />
        </shape>
    </item>
    <!-- Web navbar: gradient water line (primary → accent → primary) -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/ll_primary"
                android:centerColor="@color/ll_accent"
                android:startColor="@color/ll_primary"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
